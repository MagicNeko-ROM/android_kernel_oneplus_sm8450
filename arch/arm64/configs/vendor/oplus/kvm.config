# 虚拟化：启用 KVM（ovaltine 定制 · 2026-10-11）
#
# 背景：
#   gki_defconfig 里 CONFIG_KVM=y 本来是开的，但厂商 fragment
#   vendor/oplus/waipio_GKI.config 在 "# Bloat" 段里把它关掉了
#   （该文件第 175 行附近，与 CONFIG_VSOCKETS、CONFIG_MMC 并列）。
#   这里把它覆盖回来。
#
# 前提：
#   CONFIG_VIRTUALIZATION=y 已在 gki_defconfig 中提供。
#   ⚠️ ARM64 上 KVM 需要内核运行在 EL2；若 bootloader 把内核放在 EL1，
#      编进去也起不来 —— 以刷机后 /dev/kvm 与 dmesg 实测为准。
#
# 回退：删掉本文件，并去掉 BoardConfigCommon.mk 里的 vendor/oplus/kvm.config
CONFIG_KVM=y
